# Fuente de eventos del edge: mock | hikvision | hikcentral_pdf
# hikvision = ISAPI Digest a cada DS-K1T8003MF (NO OpenAPI / Artemis HikCentral)
SOURCE=mock

# --- Sede de este agente (un proceso = una sede geográfica) ---
SITE_CODE=oficina_central
SITE_NAME=Torre Sindoni (oficina central)
# SITE_ID=   # opcional UUID; si vacío se resuelve por SITE_CODE

# Reportes: store (recomendado) | live
REPORT_DATA_MODE=store
AUTO_SYNC_ON_REPORT=true

# --- Cliente edge → INTEGRADO ---
# Vacío = usa mock embebido en http://127.0.0.1:8003/api/asistencia/v1
INTEGRADO_BASE_URL=
ENROLLMENT_TOKEN=
AGENT_CREDENTIAL=
INTEGRADO_TIMEOUT=20

# Integración portal (usuarios humanos — no el agente)
AUTH_DISABLED=true
JWT_SECRET_KEY=
APP_CLIENT_ID=biometrico

# Lista de biométricos de ESTA sede: ID@host:port,...
HIKVISION_DEVICES=PRINCIPAL@192.168.10.200:80

# Credenciales ISAPI Digest del TERMINAL (solo viven en el edge; nunca en cloud)
HIKVISION_HOST=192.168.10.200
HIKVISION_PORT=80
HIKVISION_USER=admin
HIKVISION_PASSWORD=change-me
HIKVISION_USE_HTTPS=false
DEVICE_ID=PRINCIPAL

# Franjas de negocio (preferible por sede; hoy globales en .env)
CAFETERIA_CUTOFF=09:00:00
CAFETERIA_LATE_END=11:00:00

HIKVISION_TIMEOUT=15
HIKVISION_PAGE_SIZE=10

LETTERHEAD_PDF=../assets/hoja-membretada.pdf
