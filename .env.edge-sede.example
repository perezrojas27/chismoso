# Copiar a .env junto a docker-compose.edge-sede.yml en el equipo de SEDE.

SOURCE=hikvision
SITE_CODE=oficina_central
SITE_NAME=Torre Sindoni (oficina central)

# Portal INTEGRADO (lab oficina o producción)
INTEGRADO_BASE_URL=http://192.168.105.17:8090
# INTEGRADO_BASE_URL=https://integrado.goalbatros.com

# Mismo valor que BIOMETRICO_ENROLLMENT_TOKEN del portal (Admin/ops)
ENROLLMENT_TOKEN=cambiar-por-token-del-portal

# Consola http://ESTE-HOST:8003/ — obligatoria en producción de sede
EDGE_ADMIN_USER=admin
EDGE_ADMIN_PASSWORD=cambiar-clave-ti-sede

# Reloj(es) — o déjelos vacíos y use la consola web para detectar/agregar
HIKVISION_HOST=192.168.10.200
HIKVISION_PORT=80
HIKVISION_USER=admin
HIKVISION_PASSWORD=
HIKVISION_DEVICES=PRINCIPAL@192.168.10.200:80
EDGE_SCAN_SEED_HOST=192.168.10.200

BIOMETRICO_EDGE_PORT=8003
